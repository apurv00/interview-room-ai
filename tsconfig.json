{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["./shared/*"],
      "@modules/*": ["./modules/*"],
      "@interview": ["./modules/interview"],
      "@interview/*": ["./modules/interview/*"],
      "@learn": ["./modules/learn"],
      "@learn/*": ["./modules/learn/*"],
      "@b2b": ["./modules/b2b"],
      "@b2b/*": ["./modules/b2b/*"],
      "@cms": ["./modules/cms"],
      "@cms/*": ["./modules/cms/*"],
      "@customer-billing": ["./modules/customer-billing"],
      "@customer-billing/*": ["./modules/customer-billing/*"],
      "@financial-ledger": ["./modules/financial-ledger"],
      "@financial-ledger/*": ["./modules/financial-ledger/*"],
      "@payment-subscription-dunning": ["./modules/payment-subscription-dunning"],
      "@payment-subscription-dunning/*": ["./modules/payment-subscription-dunning/*"],
      "@payments": ["./modules/payments"],
      "@payments/customer-billing-authority": ["./modules/payments/services/customerBillingReadService.ts"],
      "@payments/*": ["./modules/payments/*"],
      "@resume": ["./modules/resume"],
      "@resume/*": ["./modules/resume/*"],
      "@feedback": ["./modules/feedback"],
      "@feedback/*": ["./modules/feedback/*"],
      "@hire": ["./modules/hire"],
      "@hire/*": ["./modules/hire/*"],
      "@hire-departments": ["./modules/hire-departments"],
      "@hire-departments/*": ["./modules/hire-departments/*"],
      "@hire-onboarding-boundary": ["./modules/hire/onboardingBoundary"],
      "@hire-decision-boundary": ["./modules/hire/decisionBoundary"],
      "@hire-decisions": ["./modules/hire-decisions"],
      "@hire-decisions/*": ["./modules/hire-decisions/*"],
      "@hire-operations-boundary": ["./modules/hire/operationsBoundary"],
      "@hire-operations": ["./modules/hire-operations"],
      "@hire-operations/*": ["./modules/hire-operations/*"],
      "@hire-digest-boundary": ["./modules/hire/digestBoundary"],
      "@hire-digest": ["./modules/hire-digest"],
      "@hire-digest/*": ["./modules/hire-digest/*"],
      "@jobs": ["./modules/jobs"],
      "@jobs/*": ["./modules/jobs/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"]
}
