{
  "name": "interview-room-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "node scripts/build-resume-css.js",
    "dev": "next dev --port 3000",
    "predev": "node scripts/build-resume-css.js",
    "dev:inngest": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "build": "next build",
    "prebuild": "node scripts/build-resume-css.js",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "pretest": "node scripts/build-resume-css.js",
    "test:run": "vitest run",
    "pretest:run": "node scripts/build-resume-css.js",
    "build:resume-css": "node scripts/build-resume-css.js",
    "test:smoke-qa": "bash qa/smoke-test.sh",
    "test:pipeline": "vitest run modules/interview/__tests__/deepgramRecognition.test.ts modules/interview/__tests__/conversationalResponses.test.ts modules/interview/__tests__/interviewPipeline.test.ts modules/interview/__tests__/ttsCache.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "pretest:pdf": "node scripts/build-resume-css.js",
    "test:pdf": "RESUME_PDF_E2E=1 vitest run modules/resume/services/__tests__/pdfRender.e2e.test.ts",
    "eval:harness": "npx tsx scripts/runEvalHarness.ts",
    "eval:load-fixtures": "npx tsx scripts/loadBenchmarkFixtures.ts",
    "eval:jobs-evidence": "node scripts/jobs-evidence-eval.mjs",
    "check:links": "npx tsx scripts/check-internal-links.ts",
    "qa:report:browser": "node scripts/generate-qa-browser-report.mjs",
    "qa:build:browser": "node scripts/validate-qa-answer-coverage.mjs --strict && node scripts/build-qa-browser-inject.mjs",
    "qa:validate:answers": "node scripts/validate-qa-answer-coverage.mjs --strict",
    "qa:audit:domain-coverage": "node scripts/audit-domain-coverage.mjs",
    "qa:audit:domain-coverage:strict": "node scripts/audit-domain-coverage.mjs --strict",
    "qa:v3:quality": "node scripts/qa-v3-quality.mjs",
    "qa:check:coverage": "node scripts/qa-check-variant-coverage.mjs",
    "qa:preflight": "node scripts/qa-preflight.mjs",
    "qa:preflight:prod": "node scripts/qa-preflight.mjs --prod",
    "qa:auth:setup": "node scripts/qa-auth-setup.mjs",
    "qa:auth:setup:prod": "node scripts/qa-auth-setup.mjs --prod",
    "qa:auth:codegen:prod": "playwright codegen --channel=chrome --save-storage=modules/qa/.auth/prod-qa.json https://www.interviewprep.guru/signin",
    "qa:auth:cdp:prod": "node scripts/qa-auth-cdp.mjs --prod",
    "qa:auth:import:prod": "node scripts/qa-auth-import-session.mjs --prod",
    "qa:auth:automation:prod": "node scripts/qa-auth-automation.mjs --prod",
    "qa:auth:automation": "node scripts/qa-auth-automation.mjs",
    "qa:auth:verify:prod": "node scripts/qa-auth-verify.mjs --prod",
    "qa:auth:verify": "node scripts/qa-auth-verify.mjs",
    "qa:v3:matrix": "node scripts/qa-v3-matrix.mjs",
    "qa:v3:matrix:prod": "node scripts/qa-v3-matrix.mjs --prod --profile full --report --observe --infra",
    "qa:v3:matrix:prod:parallel": "node scripts/qa-v3-matrix-parallel.mjs --prod --profile full --shards 3 --report --observe --infra",
    "qa:v3:smoke:prod": "node scripts/qa-v3-matrix.mjs --prod --profile ci-smoke --report --observe --infra",
    "qa:v3:mini-smoke:prod": "node scripts/qa-v3-matrix.mjs --prod --profile mini-smoke --report --observe --infra",
    "qa:v3:observe": "node scripts/qa-v3-observe.mjs",
    "qa:v3:infra": "node scripts/qa-v3-infra.mjs",
    "qa:v3:triage": "node scripts/qa-v3-triage.mjs",
    "qa:v3:diff": "node scripts/qa-v3-diff.mjs",
    "qa:v3:report": "node scripts/qa-v3-report.mjs",
    "qa:v3:ui-smoke": "node scripts/qa-v3-ui-smoke.mjs",
    "qa:v3:ui-smoke:prod": "node scripts/qa-v3-ui-smoke.mjs --prod",
    "qa:v3:gate": "node scripts/qa-v3-gate.mjs",
    "qa:v3:gate:prod": "node scripts/qa-v3-gate.mjs --prod",
    "replay:pathway": "node scripts/replay-pathway-regenerate.mjs",
    "repair:jobs-retention": "tsx -r dotenv/config scripts/repair-jobs-retention.ts",
    "check:jobs-retention": "tsx -r dotenv/config scripts/repair-jobs-retention.ts --check",
    "repair:jobs-tracker-status": "tsx -r dotenv/config scripts/repair-jobs-tracker-status.ts",
    "check:jobs-tracker-status": "tsx -r dotenv/config scripts/repair-jobs-tracker-status.ts --check",
    "repair:jobs-evidence-provenance": "tsx -r dotenv/config scripts/repair-jobs-evidence-provenance.ts",
    "check:jobs-evidence-provenance": "tsx -r dotenv/config scripts/repair-jobs-evidence-provenance.ts --check",
    "prepare:jobs-tracker-status-index": "tsx -r dotenv/config scripts/prepare-jobs-tracker-status-index.ts",
    "check:jobs-tracker-status-index": "tsx -r dotenv/config scripts/prepare-jobs-tracker-status-index.ts --check",
    "sweep:jobs-retention": "tsx -r dotenv/config scripts/sweep-jobs-retention.ts",
    "check:jobs-retention-sweep": "tsx -r dotenv/config scripts/sweep-jobs-retention.ts --check",
    "prepare:jobs-retention-index": "tsx -r dotenv/config scripts/prepare-jobs-retention-index.ts",
    "check:jobs-retention-index": "tsx -r dotenv/config scripts/prepare-jobs-retention-index.ts --check",
    "repair:jobs-source-lineage": "tsx -r dotenv/config scripts/repair-jobs-source-lineage.ts",
    "check:jobs-source-lineage": "tsx -r dotenv/config scripts/repair-jobs-source-lineage.ts --check",
    "prepare:jobs-source-control-indexes": "tsx -r dotenv/config scripts/prepare-jobs-source-control-indexes.ts",
    "prepare:jobs-verdict-governance-indexes": "tsx -r dotenv/config scripts/prepare-jobs-verdict-governance-indexes.ts",
    "check:jobs-verdict-governance-indexes": "tsx -r dotenv/config scripts/prepare-jobs-verdict-governance-indexes.ts --check",
    "prepare:hire-member-email-uniqueness": "tsx -r dotenv/config scripts/prepare-hire-member-email-uniqueness.ts",
    "check:hire-member-email-uniqueness": "tsx -r dotenv/config scripts/prepare-hire-member-email-uniqueness.ts --check",
    "prepare:hire-phase2-indexes": "tsx -r dotenv/config scripts/prepare-hire-phase2-indexes.ts",
    "check:hire-phase2-indexes": "tsx -r dotenv/config scripts/prepare-hire-phase2-indexes.ts --check",
    "check:jobs-source-control": "tsx scripts/check-jobs-source-control.ts",
    "report:jobs-discovery-quality": "tsx -r dotenv/config scripts/report-jobs-discovery-quality.ts",
    "smoke:jobs-source-control": "tsx scripts/smoke-jobs-source-control.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@auth/mongodb-adapter": "^3.11.1",
    "@aws-sdk/client-s3": "^3.1006.0",
    "@aws-sdk/s3-request-presigner": "^3.1006.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/generative-ai": "^0.24.1",
    "@mediapipe/tasks-vision": "^0.10.34",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@sparticuz/chromium": "^143.0.4",
    "@stripe/stripe-js": "^8.9.0",
    "@testing-library/dom": "^10.4.1",
    "@toon-format/toon": "^2.1.0",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.0",
    "inngest": "^4.2.0",
    "ioredis": "^5.10.0",
    "ipaddr.js": "^2.4.0",
    "lucide-react": "^1.7.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "monaco-editor": "^0.55.1",
    "mongodb": "^6.21.0",
    "mongoose": "^9.2.4",
    "nanoid": "^5.1.6",
    "next": "14.2.35",
    "next-auth": "^4.24.13",
    "openai": "^6.34.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "puppeteer-core": "^24.39.1",
    "razorpay": "2.9.8",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.0",
    "resend": "^6.9.3",
    "sharp": "^0.35.3",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "unpdf": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cursor/sdk": "^1.0.13",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10",
    "dotenv": "17.4.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jsdom": "^28.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.0",
    "tsx": "4.23.1",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
