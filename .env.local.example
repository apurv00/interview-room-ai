# Copy this file to .env.local and fill in your values

# ── Core ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Authentication ──
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=          # Generate with: openssl rand -base64 32

# ── Deployment readiness ──
# Generate independently per environment. The authenticated health endpoint
# reports dependency state and the exact deployed revision to release gates.
HEALTH_CHECK_TOKEN=       # Generate with: openssl rand -hex 32
# Coolify production/staging: set this runtime value from its SOURCE_COMMIT.
DEPLOYMENT_COMMIT_SHA=

# ── Database ──
MONGODB_URI=mongodb://localhost:27017/interview-room-ai
# Required on both isolated Hire deployments. Keep all three names distinct;
# the process refuses to connect if its URI points at the wrong database.
IPG_SURFACE=b2c                     # b2c | hire-control | hire-engine (blank only for legacy B2C with no HIRE_* config)
B2C_DATABASE_NAME=interview-room-ai
HIRE_CONTROL_DATABASE_NAME=ipg-hire-control
HIRE_RUNTIME_DATABASE_NAME=ipg-hire-runtime

# ── Redis (rate limiting + sessions) ──
REDIS_URL=redis://localhost:6379

# ── OAuth Providers (optional — leave empty to disable) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Logging ──
LOG_LEVEL=info            # debug | info | warn | error

# ── Stripe (optional — leave empty to disable payments) ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
APP_URL=http://localhost:3000

# ── Cloudflare R2 Storage ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=interviewprepguru

# ── Docker Compose Auth (required for docker-compose up) ──
MONGO_USERNAME=admin
MONGO_PASSWORD=              # Generate with: openssl rand -base64 24
REDIS_PASSWORD=              # Generate with: openssl rand -base64 24

# ── Recording ──
MAX_RECORDING_SIZE_MB=50
# Days to keep camera/screen replay videos in R2. Transcript, feedback,
# audio-only analysis artifacts, and facial landmarks are preserved.
REPLAY_RECORDING_RETENTION_DAYS=30

# ── Multimodal Analysis ──
DEEPGRAM_API_KEY=                   # Deepgram STT + TTS (https://console.deepgram.com)
DEEPGRAM_GRANT_API_KEY=             # Server-only Deepgram key allowed to mint 30s browser STT grants; never expose as NEXT_PUBLIC_*

# ── Sarvam AI (Bulbul) — the "Indian voice" interviewer personality ──
# Replaced Azure Speech on 2026-08-09 (Azure key dead in every region —
# INTERVIEW_FLOW.md §8). When the key is set AND NEXT_PUBLIC_FEATURE_VOICE_PICKER=true,
# the lobby offers an Indian-English voice that routes TTS to Sarvam instead of
# Deepgram (Sarvam returns MP3 into the same pipeline; Deepgram stays the default).
# Requesting the Indian voice WITHOUT this key logs at ERROR level and serves Deepgram.
# Create a key at https://dashboard.sarvam.ai → API Keys.
SARVAM_API_KEY=                     # api-subscription-key for api.sarvam.ai
SARVAM_TTS_SPEAKER=                 # default: ishita (Sarvam's top female en-IN pick). Alternatives: priya, shreya, shruti, kavya — lowercase, case-sensitive
SARVAM_TTS_MODEL_ID=                # default: bulbul:v3

# Note: the coding interview "Run" button uses the LLM to SIMULATE execution
# (AI-estimated output) — no code-execution sandbox is required. It runs through the
# `interview.code-run` model slot like every other interview AI call.

# ── Optional Model Routing Providers ──
GROQ_API_KEY=gsk_...               # Groq LLM provider (https://console.groq.com)
OPENAI_API_KEY=sk-...               # OpenAI (optional, enables OpenAI provider in model routing)
OPENROUTER_API_KEY=sk-or-...        # OpenRouter (optional, enables routing via any model)
GOOGLE_AI_API_KEY=                   # Google Gemini (optional, enables Gemini provider)

# ── Background Jobs (Inngest) ──
# Both keys are optional in local dev — run `npm run dev:inngest` to start the
# Inngest dev server at http://localhost:8288 which handles routing without
# any signing. B2C/control use both keys in production; hire-engine deliberately
# omits the outbound event key as documented below. Create keys in the Inngest
# Cloud dashboard: https://app.inngest.com
INNGEST_APP_ID=interview-room-ai-local
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Production Hire release gates require all three app-ID sentinels and verify
# that this deployment's INNGEST_APP_ID matches its surface. Control/runtime
# may share the existing Inngest environment; their app IDs must remain unique.
B2C_INNGEST_APP_ID=ipg-b2c-production
HIRE_CONTROL_INNGEST_APP_ID=ipg-hire-control-production
HIRE_RUNTIME_INNGEST_APP_ID=ipg-hire-runtime-production
# The hire-engine deployment intentionally leaves INNGEST_EVENT_KEY unset:
# its two functions are cron-driven, and this prevents unchanged B2C-only
# enrichment events from leaving the isolated runtime. It still requires the
# signing key so Inngest can deliver those scheduled functions.

# ── GST invoice seller policy (required before accepting live payments) ──
# These are legal invoice fields, not Razorpay Offer configuration.
PAYMENT_GST_SELLER_LEGAL_NAME=
PAYMENT_GST_SELLER_ADDRESS=
PAYMENT_GST_SELLER_STATE_CODE=       # Two-digit GST state/UT code, e.g. 20
PAYMENT_GST_SELLER_GSTIN=            # 15-character GSTIN; must start with the state code
PAYMENT_GST_SERVICE_SAC=             # Six-digit service accounting code

# ── Email (Resend) ──
# Used by the B2B invite-OTP flow and transactional sends. sendEmail() is a
# silent no-op when RESEND_API_KEY is unset. Note: the daily engagement
# digest is HARD-DISABLED in code (modules/learn/jobs/emailDigestJob.ts)
# pending its dedupe/frequency fixes — no env var enables it, by design.
RESEND_API_KEY=                     # https://resend.com API key
EMAIL_FROM=                         # Verified sender, e.g. "InterviewPrep Guru <hello@interviewprep.guru>"

# ── IPG Hire isolated control/runtime deployments ──
HIRE_PUBLIC_URL=https://hire.interviewprep.guru
HIRE_ENGINE_RUNTIME_URL=https://hire-runtime.example.com # any distinct HTTPS origin
# Browser-facing control origin used by the runtime completion redirect.
HIRE_CONTROL_URL=https://hire.interviewprep.guru
HIRE_HANDOFF_ISSUANCE_MODE=open # hire-control only: open | draining | smoke
HIRE_HANDOFF_SMOKE_TOKEN=       # hire-control smoke mode only, >=32 secret bytes
HIRE_CONTROL_INTERNAL_URL=https://hire.interviewprep.guru
HIRE_ENGINE_BRIDGE_KEY_ID=hire-bridge-current
HIRE_ENGINE_BRIDGE_SECRET=          # shared control/runtime, >=32 random chars
HIRE_ACCOUNT_BRIDGE_KEY_ID=hire-account-bridge-current
HIRE_ACCOUNT_BRIDGE_SECRET=         # shared B2C/control, >=32 random chars; keep separate from engine bridge
# Control-only AES-256-GCM key for crash-safe AI invite recovery. Generate
# with `openssl rand -base64 32`. Rotate by moving the old pair to *_PREVIOUS;
# remove it only after every invite encrypted by that key has expired (7 days).
HIRE_INVITE_DELIVERY_KEY_ID=hire-invite-2026-08
HIRE_INVITE_DELIVERY_KEY=
HIRE_INVITE_DELIVERY_KEY_ID_PREVIOUS=
HIRE_INVITE_DELIVERY_KEY_PREVIOUS=
# The hire-engine also requires the conventional NEXTAUTH_SECRET declared in
# Authentication above because the global withAuth middleware reads it before
# applying the runtime allowlist. Generate a fresh >=32-character value for
# that deployment only: never copy the B2C secret and never make it equal to
# HIRE_RUNTIME_NEXTAUTH_SECRET. It does not sign runtime candidate sessions.
HIRE_RUNTIME_NEXTAUTH_SECRET=       # runtime-only; never reuse NEXTAUTH_SECRET
HIRE_RUNTIME_FENCE_SECRET=          # runtime-only internal proxy secret, >=32 random chars
HIRE_RUNTIME_R2_ACCOUNT_ID=
HIRE_RUNTIME_R2_ACCESS_KEY_ID=      # runtime-only credential
HIRE_RUNTIME_R2_SECRET_ACCESS_KEY=
HIRE_RUNTIME_R2_BUCKET_NAME=ipg-hire-runtime-staging
# On the hire-engine deployment only, the unchanged engine reads R2_*.
# Set those four generic R2_* values to these exact runtime values. The
# readiness gate rejects a mismatch. Control and runtime may use the same
# bucket/credential because all Hire keys have workspace-prefixed namespaces.
# Also set NEXTAUTH_URL to exactly HIRE_ENGINE_RUNTIME_URL on hire-engine.

# ── Analytics ──
# Both sinks are independent — leave either blank to disable that sink.
# track() fans out to both from a single call site (shared/analytics/track.ts).
NEXT_PUBLIC_GA_MEASUREMENT_ID=          # GA4 measurement ID (e.g. G-XXXXXXXXXX). No-op when unset.
NEXT_PUBLIC_POSTHOG_KEY=                # PostHog public project key. No-op when unset.
NEXT_PUBLIC_POSTHOG_HOST=               # Optional; defaults to https://us.i.posthog.com

# ── Feature Flags ──
FEATURE_FLAG_MULTIMODAL_ANALYSIS=true    # Enable post-interview multimodal analysis
NEXT_PUBLIC_FEATURE_MULTIMODAL=true      # Enable real-time multimodal during interview (client-side)
NEXT_PUBLIC_FEATURE_VOICE_PICKER=        # 'true' shows the lobby "Indian-accent voice" picker (needs SARVAM_API_KEY set)
NEXT_PUBLIC_FEATURE_ADAPTIVE_GRACE=      # 'true' = confident/clean answers close ~2s faster (~1.1s grace vs 3s); incomplete/'let me think' unchanged. Ship dark; measure cutoff rate in a real interview before enabling.

# ── QA Matrix Automation (Playwright overnight runs) ──
# Set on Vercel production AND in local .env.local for prod matrix runs.
# Playwright calls POST /api/qa/automation-login — no OAuth in the browser.
QA_AUTOMATION_ENABLED=true
QA_AUTOMATION_SECRET=                    # openssl rand -hex 32 — same value locally + Vercel
QA_AUTOMATION_EMAIL=                     # Existing user email in MongoDB (dedicated QA account)
# Optional: prod Atlas URI for post-run pathway verification (npm run qa:v3:infra -- --prod)
MONGODB_URI_PROD=
# Optional: Linear ticket sync from triage (npm run qa:v3:triage -- <id> --linear)
LINEAR_API_KEY=
