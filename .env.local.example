# Copy this file to .env.local and fill in your values

# ── Core ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Authentication ──
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=          # Generate with: openssl rand -base64 32

# ── Database ──
MONGODB_URI=mongodb://localhost:27017/interview-room-ai

# ── Redis (rate limiting + sessions) ──
REDIS_URL=redis://localhost:6379

# ── OAuth Providers (optional — leave empty to disable) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Logging ──
LOG_LEVEL=info            # debug | info | warn | error

# ── Stripe (optional — leave empty to disable payments) ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
APP_URL=http://localhost:3000

# ── Cloudflare R2 Storage ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=interviewprepguru

# ── Docker Compose Auth (required for docker-compose up) ──
MONGO_USERNAME=admin
MONGO_PASSWORD=              # Generate with: openssl rand -base64 24
REDIS_PASSWORD=              # Generate with: openssl rand -base64 24

# ── Recording ──
MAX_RECORDING_SIZE_MB=50
# Days to keep camera/screen replay videos in R2. Transcript, feedback,
# audio-only analysis artifacts, and facial landmarks are preserved.
REPLAY_RECORDING_RETENTION_DAYS=30

# ── Multimodal Analysis ──
DEEPGRAM_API_KEY=                   # Deepgram STT + TTS (https://console.deepgram.com)

# ── Optional Model Routing Providers ──
GROQ_API_KEY=gsk_...               # Groq LLM provider (https://console.groq.com)
OPENAI_API_KEY=sk-...               # OpenAI (optional, enables OpenAI provider in model routing)
OPENROUTER_API_KEY=sk-or-...        # OpenRouter (optional, enables routing via any model)
GOOGLE_AI_API_KEY=                   # Google Gemini (optional, enables Gemini provider)

# ── Background Jobs (Inngest) ──
# Both keys are optional in local dev — run `npm run dev:inngest` to start the
# Inngest dev server at http://localhost:8288 which handles routing without
# any signing. In production (Vercel), both keys are required. Create them in
# the Inngest Cloud dashboard: https://app.inngest.com
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Analytics ──
# Both sinks are independent — leave either blank to disable that sink.
# track() fans out to both from a single call site (shared/analytics/track.ts).
NEXT_PUBLIC_GA_MEASUREMENT_ID=          # GA4 measurement ID (e.g. G-XXXXXXXXXX). No-op when unset.
NEXT_PUBLIC_POSTHOG_KEY=                # PostHog public project key. No-op when unset.
NEXT_PUBLIC_POSTHOG_HOST=               # Optional; defaults to https://us.i.posthog.com

# ── Feature Flags ──
FEATURE_FLAG_MULTIMODAL_ANALYSIS=true    # Enable post-interview multimodal analysis
NEXT_PUBLIC_FEATURE_MULTIMODAL=true      # Enable real-time multimodal during interview (client-side)

# ── QA Matrix Automation (Playwright overnight runs) ──
# Set on Vercel production AND in local .env.local for prod matrix runs.
# Playwright calls POST /api/qa/automation-login — no OAuth in the browser.
QA_AUTOMATION_ENABLED=true
QA_AUTOMATION_SECRET=                    # openssl rand -hex 32 — same value locally + Vercel
QA_AUTOMATION_EMAIL=                     # Existing user email in MongoDB (dedicated QA account)
# Optional: prod Atlas URI for post-run pathway verification (npm run qa:v3:infra -- --prod)
MONGODB_URI_PROD=
